# Neon Postgres — pooled connection string (Vercel: set in project env)
DATABASE_URL=

# Auth.js JWT signing secret (generate: npx auth secret)
AUTH_SECRET=

# AI provider — configurable in the UI (Settings → AI Model), which overrides
# these. Env fallback order: Gemini first, then Anthropic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Vercel Blob (doctor-note images, documents)
BLOB_READ_WRITE_TOKEN=

# Sphera guide (Groq) — Settings → Guide Assistant overrides these.
# NOTE: the variable is GROQ_API_KEY (GROQ_API also accepted as an alias).
# On Vercel, set this in the project's Environment Variables — .env files
# are not deployed.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
